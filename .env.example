DOCKER_IMAGE_WEB=wpxm/perfect
DOCKER_IMAGE_WP_VERSION=6.7
DOCKER_IMAGE_PHP_VERSION=8.3

# Database configuration
# WARNING: defaults are for local dev only — change before any non-local use.
DB_NAME=wpxm
DB_USER=user
DB_PASSWORD=pass
DB_ROOT_PASSWORD=root

# WordPress configuration
WP_URL=https://wpxm.localhost
WP_TITLE=WPXM
WP_USERNAME=user
WP_PASS=pass
WP_EMAIL=random@mail.fr
WP_LOCAL=fr_FR
WP_TIMEZONE=Europe/Paris
WP_DATE_FORMAT=d/m/Y
WP_TIME_FORMAT=H:i

# Multisite (used by `make wp-add-site`)
WP_MULTISITE_TITLE=Site1
WP_MULTISITE_SLUG=Site1


WP_THEME=ollie

# Plugins to install from the wp.org repo (space-separated slugs).
# Activated automatically.
# WP_PLUGINS=wp-graphql wp-graphql-acf wp-graphql-woocommerce
# WP_PLUGINS=

# Plugins to install from a local zip file (path INSIDE the container) or a
# remote URL. Space-separated. Not auto-activated.
# The host ./plugins/ directory is mounted as /var/plugins (zips gitignored,
# so drop your local zips there and reference them as /var/plugins/foo.zip).
# Useful for premium plugins, custom in-house plugins, or pinned versions.
# WP_PLUGINS_D=/var/plugins/your-plugin.zip https://example.com/another.zip
