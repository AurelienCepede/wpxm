# =============================================================================
# WPXM - Configuration d'environnement
# =============================================================================
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins
# cp env.example .env

# =============================================================================
# DOCKER IMAGES
# =============================================================================
# Nom de l'image Docker personnalisée pour WordPress
DOCKER_IMAGE_WEB=wpxm-web

# Version de WordPress à utiliser
# Versions disponibles : 6.4, 6.3, 6.2, etc.
DOCKER_IMAGE_WP_VERSION=6.4

# Version de PHP à utiliser
# Versions disponibles : 8.2, 8.1, 8.0, 7.4
DOCKER_IMAGE_PHP_VERSION=8.2

# =============================================================================
# BASE DE DONNÉES
# =============================================================================
# Nom de la base de données WordPress
DB_NAME=wordpress

# Utilisateur de la base de données
DB_USER=wp_user

# Mot de passe de l'utilisateur de la base de données
# ⚠️ Changez ce mot de passe pour la sécurité !
DB_PASSWORD=secure_password

# Mot de passe root de la base de données
# ⚠️ Changez ce mot de passe pour la sécurité !
MYSQL_ROOT_PASSWORD=secure_root_password

# =============================================================================
# WORDPRESS - CONFIGURATION GÉNÉRALE
# =============================================================================
# URL de votre site WordPress (sans slash final)
WP_URL=http://localhost

# Titre du site WordPress
WP_TITLE="Mon Site WordPress"

# Nom d'utilisateur administrateur
WP_USERNAME=admin

# Mot de passe administrateur
# ⚠️ Changez ce mot de passe pour la sécurité !
WP_PASS=admin_password

# Email administrateur
WP_EMAIL=admin@example.com

# =============================================================================
# WORDPRESS - LOCALISATION
# =============================================================================
# Locale WordPress (langue)
# Exemples : fr_FR, en_US, es_ES, de_DE
WP_LOCAL=fr_FR

# Fuseau horaire
# Exemples : Europe/Paris, America/New_York, Asia/Tokyo
WP_TIMEZONE=Europe/Paris

# Format de date
# Exemples : d/m/Y, Y-m-d, m/d/Y
WP_DATE_FORMAT=d/m/Y

# Format d'heure
# Exemples : H:i, g:i A, H:i:s
WP_TIME_FORMAT=H:i

# =============================================================================
# WORDPRESS - PLUGINS
# =============================================================================
# Plugins à installer et activer automatiquement
# Séparez plusieurs plugins par des espaces
# Exemples : "woocommerce contact-form-7 yoast-seo"
WP_PLUGINS=""

# Plugins à installer mais laisser désactivés
# Utile pour les plugins de développement comme Query Monitor
WP_PLUGINS_D=""

# =============================================================================
# WORDPRESS - THÈME
# =============================================================================
# Thème à installer et activer automatiquement
# Exemples : twentytwentyfour, twentytwentythree, astra
WP_THEME=twentytwentyfour

# =============================================================================
# WORDPRESS - MULTISITE (optionnel)
# =============================================================================
# Slug du site à créer (pour multisite)
WP_MULTISITE_SLUG=site2

# Titre du site à créer (pour multisite)
WP_MULTISITE_TITLE="Site 2"

# =============================================================================
# IMPORT/MIGRATION (optionnel)
# =============================================================================
# URL de l'ancien site (pour remplacement lors de l'import)
# Utilisé avec make import-db
WP_IMPORT_URL=http://ancien-site.com

# Chemin de l'ancien site (pour remplacement lors de l'import)
# Utilisé avec make import-db
WP_IMPORT_FOLDER=/var/www/html

# =============================================================================
# NOTES DE SÉCURITÉ
# =============================================================================
# ⚠️ IMPORTANT : Ce fichier .env est pour le développement local uniquement
# 
# Pour la production :
# - Utilisez des mots de passe forts et uniques
# - Ne partagez jamais ce fichier
# - Utilisez des variables d'environnement sécurisées
# - Changez les ports par défaut si nécessaire
#
# Mots de passe recommandés :
# - Au moins 12 caractères
# - Mélange de majuscules, minuscules, chiffres et symboles
# - Exemple : K9#mP2$vL8@nQ4 